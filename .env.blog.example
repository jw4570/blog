# .env.local로 복사하세요. 배포 시 동일한 값을 환경 변수로 등록하세요.
# NEXT_PUBLIC_LINK는 배포된 실제 블로그 주소로 변경하세요.
NOTION_PAGE_ID=3fe7633d9bef8001878ed9314427e027
API_BASE_URL=https://app.notion.com/api/v3
NEXT_PUBLIC_THEME=simple
NEXT_PUBLIC_LANG=ko-KR
NEXT_PUBLIC_AUTHOR=Juwon
NEXT_PUBLIC_BIO="배우고 만들며 남기는 기록"
NEXT_PUBLIC_SINCE=2026
NEXT_PUBLIC_LINK=http://localhost:3000
NEXT_PUBLIC_CUSTOM_MENU=false
NEXT_PUBLIC_NOTION_PROPERTY_TITLE=title
NEXT_PUBLIC_NOTION_PROPERTY_STATUS=status
NEXT_PUBLIC_NOTION_PROPERTY_STATUS_PUBLISH=Public
NEXT_PUBLIC_NOTION_PROPERTY_STATUS_INVISIBLE=Unlisted
NOTION_DEFAULT_POST_TYPE=Post
NEXT_PUBLIC_REVALIDATE_SECOND=60
NEXT_PUBLIC_ANALYTICS_BUSUANZI_ENABLE=false
# 로컬 개발은 false, 배포에서는 true를 사용하세요.
ENABLE_CACHE=false
